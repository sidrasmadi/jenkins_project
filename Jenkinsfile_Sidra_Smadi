pipeline {
    agent any
    environment {
        VIRTUAL_ENV = 'venv'
        PATH = "C:\\Users\\sidra\\AppData\\Local\\Programs\\Python\\Python311;${env.PATH}"
    }
    stages {
        stage('Setup') {
            steps {
                script {
                    if (!fileExists("${env.WORKSPACE}/${VIRTUAL_ENV}")) {
                        bat "python -m venv ${VIRTUAL_ENV}"
                    }
                    bat "call ${VIRTUAL_ENV}\\Scripts\\activate && pip install -r requirements.txt"
                }
            }
        }
        stage('Lint') {
            steps {
                script {
                    bat "call ${VIRTUAL_ENV}\\Scripts\\activate && flake8 app.py"
                }
            }
        }
        stage('Test') {
            steps {
                script {
                    bat "call ${VIRTUAL_ENV}\\Scripts\\activate && pytest"
                }
            }
        }
        stage('Coverage') {
            steps {
                script {
                    bat "call ${VIRTUAL_ENV}\\Scripts\\activate && coverage run -m pytest && coverage report -m"
                }
            }
        }
        stage('Security Scan') {
            steps {
                script {
                    bat "call ${VIRTUAL_ENV}\\Scripts\\activate && bandit -r app.py"
                }
            }
        }
        stage('Deploy') {
            steps {
                script {
                    echo "Deploying application..."
                    bat "call ${VIRTUAL_ENV}\\Scripts\\activate && deploy.bat"
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
